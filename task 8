#include <iostream>
#include <vector>
using namespace std;

using State = vector<vector<string>>;

bool isGoal(const State& s) {
    for (int i = 0; i < s.size(); i++) {
        if (s[i].empty()) continue;
        for (int j = 0; j < s[i].size(); j++) {
            if (s[i][j] != s[i][0]) return false;
        }
    }
    return true;
}

bool canMove(const State& s, int a, int b, int cap) {
    if (a == b) return false;
    if (s[a].empty()) return false;
    if (s[b].size() == cap) return false;
    if (s[b].empty()) return true;
    return s[a].back() == s[b].back();
}

State makeMove(State s, int a, int b) {
    string x = s[a].back();
    s[a].pop_back();
    s[b].push_back(x);
    return s;
}

bool visitedBefore(const vector<State>& visited, const State& s) {
    for (int i = 0; i < visited.size(); i++) {
        if (visited[i] == s) return true;
    }
    return false;
}

bool dfs(State s, int n, int cap,
         vector<State>& visited,
         vector<pair<int,int>>& path) {

    if (isGoal(s)) return true;

    visited.push_back(s);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (canMove(s, i, j, cap)) {
                State next = makeMove(s, i, j);
                if (!visitedBefore(visited, next)) {
                    path.push_back(pair<int,int>(i, j));
                    if (dfs(next, n, cap, visited, path))
                        return true;
                    path.pop_back();
                }
            }
        }
    }
    return false;
}

int main() {
    int n, cap;
    cout << "Number of stacks: ";
    cin >> n;
    cout << "Stack capacity: ";
    cin >> cap;

    State start(n);

    for (int i = 0; i < n; i++) {
        cout << "Stack " << i << " (top to bottom, x to stop): ";
        string c;
        while (cin >> c && c != "x") {
            start[i].push_back(c);
        }
    }

    vector<State> visited;
    vector<pair<int,int>> path;

    if (dfs(start, n, cap, visited, path)) {
        State cur = start;
        cout << "\nMoves:\n";
        for (int i = 0; i < path.size(); i++) {
            int from = path[i].first;
            int to = path[i].second;
            string color = cur[from].back();
            cur = makeMove(cur, from, to);
            cout << "Move " << color
                 << " from " << from
                 << " to " << to << endl;
        }
    } else {
        cout << "No solution\n";
    }
}
