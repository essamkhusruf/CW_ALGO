#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
using namespace std;

string findFake(const vector<int>& coins, int genuine, int& idx) {
    for (int i = 0; i < coins.size(); i++) {
        if (coins[i] != genuine) {
            idx = i;
            return (coins[i] < genuine ? "Fake coin is LIGHTER." : "Fake coin is HEAVIER.");
        }
    }
    return "No fake coin found.";
}

int main() {
    srand(time(0));

    int n;
    cin >> n;

    if (n <= 2) return 0;

    int genuine = 10;
    vector<int> coins(n, genuine);

    int fakeIndex = rand() % n;
    int fakeWeight = (rand() % 2 == 0 ? genuine - 1 : genuine + 1);
    coins[fakeIndex] = fakeWeight;

    int idx = -1;
    cout << findFake(coins, genuine, idx) << endl;

    cout << "Fake index: " << fakeIndex
         << ", Fake weight: " << fakeWeight << endl;

    return 0;
}
